 "segments": [
  {
   "start": 4.76,
   "end": 9.08,
   "text": "Hayastan, l'odeur des épices."
  },
  {
   "start": 40.08,
   "end": 43.2,
   "text": "Feuille de vigne tendre, roulée avec soin"
  },
  {
   "start": 43.2,
   "end": 47.08,
   "text": "Dolma qui brille dans l'assiette, pur bonheur"
  },
  {
   "start": 47.08,
   "end": 50.46,
   "text": "Riz parfumé, viande hachée, herbe qui danse"
  },
  {
   "start": 50.46,
   "end": 54.02,
   "text": "Un petit paquet vert, saveur d'enfance immense"
  },
  {
   "start": 54.02,
   "end": 57.5,
   "text": "La vache fin comme une caresse, cuit au tonir chaud"
  },
  {
   "start": 57.5,
   "end": 59.54,
   "text": "Et tant que du claqué contre le mur"
  },
  {
   "start": 59.54,
   "end": 61.3,
   "text": "Doré en un éclair"
  },
  {
   "start": 61.3,
   "end": 63.04,
   "text": "Peint de tous les jours"
  },
  {
   "start": 63.04,
   "end": 64.48,
   "text": "Une escro dans le cœur"
  },
  {
   "start": 64.48,
   "end": 67.22,
   "text": "Avec lui tout s'enroule, tout se partage"
  },
  {
   "start": 67.22,
   "end": 68.38,
   "text": "Tout est meilleur"
  },
  {
   "start": 70.3,
   "end": 72.32,
   "text": "Oh dolma, keuf tes beurres"
  },
  {
   "start": 72.32,
   "end": 73.34,
   "text": "Boulez !"
  },
  {
   "start": 73.34,
   "end": 75.98,
   "text": "Boubou le keuf tes qui fondent en bouche"
  },
  {
   "start": 75.98,
   "end": 78.24,
   "text": "Suju qui craque, passe sur ma qui pique"
  },
  {
   "start": 78.24,
   "end": 81.72,
   "text": "A table en Arménie, on rit, on savoure en vie"
  },
  {
